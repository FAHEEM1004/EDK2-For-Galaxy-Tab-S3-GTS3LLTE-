[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = HdmiDxe
  FILE_GUID      = CADBECF0-1234-5067-C78A-BCDEF0123456
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  ENTRY_POINT    = HdmiDxeInitialize

[Sources]
  HdmiDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  ArmPkg/ArmPkg.dec
  SamsungPkg/SamsungPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  BaseLib
  BaseMemoryLib
  DebugLib
  IoLib
  MemoryAllocationLib
  TimerLib
  UefiBootServicesTableLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid

[Depex]
  TRUE
